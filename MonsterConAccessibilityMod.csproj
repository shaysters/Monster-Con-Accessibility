<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Folder that contains the game's .exe. Override with -p:GameDir="..." -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Monster Prom 4 - Monster Con</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MonsterConAccessibilityMod</AssemblyName>
    <RootNamespace>MonsterConAccessibilityMod</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="decompiled\**\*.cs" />
    <Compile Remove="SapiHelper\**\*.cs" />
    <Compile Remove="ManualUnityExport\**\*.cs" />
    <None Remove="decompiled\**\*" />
    <None Remove="ManualUnityExport\**\*" />
    <EmbeddedResource Remove="ManualUnityExport\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\MonsterCon_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\MonsterCon_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\MonsterCon_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameDir)\MonsterCon_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\MonsterCon_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\MonsterCon_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Prism\prism.dll" Link="prism.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Prism\LICENSE;Prism\NOTICE" Link="Prism\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Prism\LICENSES\**\*" Link="Prism\LICENSES\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ManualPages.en.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
